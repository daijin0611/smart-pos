# 生产环境配置 - 复制为 .env 并填入实际值
# 此文件包含敏感信息，已在 .gitignore 中排除

# 数据库（覆盖 application-prod.yml 中的默认值）
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/pos?useUnicode=true&characterEncoding=utf-8&useSSL=true&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=pos
# SPRING_DATASOURCE_PASSWORD=

# Redis（覆盖 application-prod.yml 中的默认值）
# SPRING_DATA_REDIS_HOST=127.0.0.1
# SPRING_DATA_REDIS_PASSWORD=
