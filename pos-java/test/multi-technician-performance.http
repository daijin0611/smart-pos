### A7: 完整结算流程（主线，后续 C1-C4 / D1-D3 依赖此流程）
### 流程: 开单 → 添加明细 → 结算 → 查询
###

### A7-1: 开单 (2技师)
POST {{baseUrl}}/order/add-order
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerType": 1,
  "customerName": "A7-Test",
  "bedId": 39,
  "orderDetails": [
    {
      "detailType": 1,
      "bid": 1,
      "quantity": 1,
      "stdPrice": 100.00,
      "truePrice": 100.00,
      "serverType": 0,
      "technicians": [
        {"userId": 2, "userName": "FR"},
        {"userId": 3, "userName": "YZY"}
      ]
    }
  ]
}

> {%
  client.test("A7-1: order created", function () {
    client.assert(response.body.code === 10000, "Failed: " + response.body.message);
  });
  client.global.set("orderId_A7", response.body.data.orderId);
  client.global.set("orderCode_A7", response.body.data.orderCode);
%}

### A7-2: 查询订单
GET {{baseUrl}}/order/query-by-id/{{orderId_A7}}
Authorization: Bearer {{token}}

> {%
  var details = response.body.data.orderDetails;
  client.test("A7-2: query ok", function () {
    client.assert(response.body.code === 10000, "Query failed");
    client.assert(details.length >= 1, "Should have at least 1 detail");
  });
  if (details && details.length >= 1) {
    client.log("technicianNames: " + JSON.stringify(details[0].technicianNames));
  }
%}

### A7-3: 添加明细 (3技师)
POST {{baseUrl}}/order/add-detail/{{orderId_A7}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "detailType": 1,
  "bid": 2,
  "quantity": 1,
  "stdPrice": 100.00,
  "truePrice": 100.00,
  "serverType": 1,
  "technicians": [
    {"userId": 4, "userName": "YJH"},
    {"userId": 5, "userName": "ZYX"},
    {"userId": 6, "userName": "ZXY"}
  ]
}

> {%
  client.test("A7-3: detail added", function () {
    client.assert(response.body.code === 10000, "Add detail failed: " + response.body.message);
  });
%}

### A7-4: 结算订单
POST {{baseUrl}}/order/settle-order
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "orderId": {{orderId_A7}},
  "customerType": 1,
  "customerName": "A7-Test",
  "totalAmount": 200.00,
  "actualAmount": 200.00,
  "discountAmount": 0,
  "orderDetails": [
    {
      "detailType": 1, "bid": 1, "businessName": "FootMassage", "businessCode": "SRV001",
      "stdPrice": 100.00, "truePrice": 100.00, "quantity": 1, "serverType": 0,
      "technicians": [{"userId": 2, "userName": "FR"}, {"userId": 3, "userName": "YZY"}]
    },
    {
      "detailType": 1, "bid": 2, "businessName": "EarClean", "businessCode": "SRV002",
      "stdPrice": 100.00, "truePrice": 100.00, "quantity": 1, "serverType": 1,
      "technicians": [{"userId": 4, "userName": "YJH"}, {"userId": 5, "userName": "ZYX"}, {"userId": 6, "userName": "ZXY"}]
    }
  ],
  "paymentInfoList": [{"paymentType": 1, "paymentName": "Cash", "paymentAmount": 200.00}]
}

> {%
  client.test("A7-4: settle success", function () {
    client.assert(response.body.code === 10000, "Settle failed: " + response.body.message);
  });
  client.global.set("orderCode_A7", response.body.data.orderCode);
%}

### A8: 查询已结算订单 - 验证 technicianNames
GET {{baseUrl}}/order/query-by-id/{{orderId_A7}}
Authorization: Bearer {{token}}

> {%
  var details = response.body.data.orderDetails;
  client.test("A8: 2 details", function () {
    client.assert(response.body.code === 10000, "Query failed");
    client.assert(details.length === 2, "Expected 2 details, got " + details.length);
  });
  if (details && details.length >= 2) {
    client.test("A8: detail[0] has 2 technicians", function () {
      client.assert(details[0].technicianNames.length === 2, "Expected 2");
    });
    client.test("A8: detail[1] has 3 technicians", function () {
      client.assert(details[1].technicianNames.length === 3, "Expected 3");
    });
    client.log("detail[0]: " + JSON.stringify(details[0].technicianNames));
    client.log("detail[1]: " + JSON.stringify(details[1].technicianNames));
  }
%}

