### 多人业绩分配功能 API 测试用例
### 环境: dev | 执行顺序: 从上到下（存在数据依赖）

### 0. 登录获取 Token
POST {{baseUrl}}/auth/login
Content-Type: application/x-www-form-urlencoded

username=N15287842664&password=123456

> {%
  client.global.set("token", response.body.data.token);
  client.log("Token saved");
%}

### A1: 开单 - 单技师单明细
POST {{baseUrl}}/order/add-order
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerType": 1,
  "customerName": "丁铭瀚",
  "bedId": 39,
  "orderDetails": [
    {
      "detailType": 1,
      "bid": 1,
      "quantity": 1,
      "stdPrice": 100.00,
      "truePrice": 100.00,
      "serverType": 0,
      "technicians": [
        {"userId": 2, "userName": "方睿"}
      ]
    }
  ]
}

> {%
  client.test("A1: code=10000", function () {
    client.assert(response.body.code === 10000, "Expected 10000, got " + response.body.code);
    client.assert(response.body.data.orderId != null, "orderId should not be null");
  });
  client.global.set("orderId_A1", response.body.data.orderId);
%}

### A1-清理: 结算释放床位
POST {{baseUrl}}/order/settle-order
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "orderId": {{orderId_A1}},
  "customerType": 1,
  "customerName": "A1-Test",
  "totalAmount": 100.00,
  "actualAmount": 100.00,
  "discountAmount": 0,
  "orderDetails": [
    {
      "detailType": 1, "bid": 1, "businessName": "FootMassage", "businessCode": "SRV001",
      "stdPrice": 100.00, "truePrice": 100.00, "quantity": 1, "serverType": 0,
      "technicians": [{"userId": 2, "userName": "FR"}]
    }
  ],
  "paymentInfoList": [{"paymentType": 1, "paymentName": "Cash", "paymentAmount": 100.00}]
}

> {%
  client.test("A1-settle", function () {
    client.assert(response.body.code === 10000, "Settle failed: " + response.body.message);
  });
%}

